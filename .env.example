# GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to keep analytics off.
# Analytics also requires a user consent flow before it activates; see
# app/lib/analytics.ts.
VITE_GA4_ID=

# Google Tag Manager container id. Defaults to the site container in app/root.tsx
# and only loads on the production domain. Set this to override it, or to an
# empty value to disable GTM entirely.
VITE_GTM_ID=
